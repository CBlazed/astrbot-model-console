{
  "name": "astrbot-model-console",
  "version": "0.2.2",
  "private": true,
  "description": "本机优先的 AstrBot 模型配置可视化编辑器：预览后应用、写入前备份，支持 HTTP/SSH/Agent 远程设备。",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.22"
  },
  "keywords": [
    "astrbot",
    "model",
    "console",
    "dashboard",
    "llm",
    "provider"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CBlazed/astrbot-model-console.git"
  },
  "homepage": "https://github.com/CBlazed/astrbot-model-console#readme",
  "bugs": {
    "url": "https://github.com/CBlazed/astrbot-model-console/issues"
  },
  "scripts": {
    "test": "node --test --test-isolation=none",
    "test:plain": "node --test",
    "start": "node src/server.mjs",
    "inspect": "node src/inspect.mjs",
    "build": "node scripts/build-package.mjs"
  }
}
